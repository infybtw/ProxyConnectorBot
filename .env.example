# --- Required ---
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:your-token-here

# Public base URL of the subscription endpoint (no trailing slash).
# In production this is the domain Caddy serves, e.g. https://sub.example.com
PUBLIC_BASE_URL=https://pcb.localhost

# Domain Caddy serves (must match PUBLIC_BASE_URL host)
APP_DOMAIN=pcb.localhost

# --- Production only ---
CADDY_EMAIL=admin@example.com
POSTGRES_PASSWORD=change-me

# --- Optional ---
# Postgres connection (compose sets DATABASE_URL for the app automatically;
# this one is only needed when running the app outside docker).
# DATABASE_URL=postgres://pcb:pcb@localhost:5433/pcb?sslmode=disable

POSTGRES_USER=pcb
POSTGRES_DB=pcb
POSTGRES_PORT=5433

# Interface language for new users (ru / en). Existing users keep /lang choice.
DEFAULT_LOCALE=ru

# Device identity sent to origin servers together with the HWID
# (x-device-os / x-ver-os / x-device-model headers).
HWID_DEVICE_OS=android
HWID_VER_OS=14
HWID_DEVICE_MODEL=Pixel 7
ORIGIN_USER_AGENT=Happ/2.4.1 (Android 14)

# Timeout of a single origin request (Go-style duration: 20s, 1m30s, 500ms)
ORIGIN_TIMEOUT=20s

# Maximum size of an origin subscription body, in bytes (default 20 MiB)
ORIGIN_MAX_BODY=20971520

# Log level: debug / info / warn / error
LOG_LEVEL=info
